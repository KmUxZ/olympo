{
  "manifest_version": 3,
  "name": "Argos — Registro de turno (OLYMPO)",
  "short_name": "Argos",
  "version": "0.7.1",
  "description": "Registra tu turno, pausas y actividad agregada en las herramientas de trabajo autorizadas. No guarda texto, teclas ni contraseñas.",
  "incognito": "not_allowed",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "idle", "scripting", "sidePanel"],
  "side_panel": { "default_path": "popup.html?side=1" },
  "host_permissions": ["http://localhost:4000/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" },
    "default_popup": "popup.html",
    "default_title": "Argos — Registro de turno"
  }
}
